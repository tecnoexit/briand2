    color: white;
    font-size: 17px;
    font-weight: bold;
    margin-bottom: 20px;
    width: 100%;
    text-align: center;
}
.mto-contador input[name="qty"] {
    border: none !important;
    border-radius: none !important;
    padding: 5px;
    max-width: 50px;
    border-radius: 2px !important;
    text-align: center;
}
.mto-contador-precio {
    padding: 0 5px;
}
.mto-articulo {
    background-color: rgb(239 239 239);
    border: none;
    border-radius: 8px;
    border-bottom: 3px solid #bbb;
    margin: 4px 0;
    transition: all ease .3s;
}
.mto-articulo:hover {
    border-bottom: 3px solid rgb(129, 129, 129);
}
@media (max-width : 500px) {
    .mto-contador {
        width: 100%;
    }
    .mto-contador-resultado {
        width: 100%;
        text-align: center;
    }
}
.mto-contador .input-group {
    width: unset;
}
.mto-contenedor-contador .input-group.bootstrap-touchspin {
    margin-bottom: 0 !important;
}
.mto-contenedor-contador .mto-consultar {
    background-color: rgb(75, 196, 75) !important;
    border-radius: 10px !important;
    transition: all ease .3s;
}
.mto-contenedor-contador .mto-consultar:hover {
    border: 1px solid black !important;
}
.col.view-switcher.hidden-sm-down {
    visibility: hidden;
}
.comprar-mayorista {
    background-color: #0169D8 !important;
    border-radius: 10px !important;
    font-weight: 700 !important;
    transition: all ease .2s;
}
.comprar-mayorista:hover {
    background-color: #6FB64E !important;
}

</style>
    

    
        
    

