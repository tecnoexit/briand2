<script>
var mptools_commisions = [];
function mptools_commisions_installment() {
    var html = '';
    if (mptools_commisions.length == 0) {
        mptools_commisions.push({
            'name': "Pagar con MercadoPago -15% de Descuento",
            'price': 1724.06
        });
    }
    for(var i in mptools_commisions) {
        var c = mptools_commisions[i];
        html += '<b>Costos de las cuotas para '+c.name+':</b><div id="mptools_commisions_'+i+'"></div><br />';
    }
    $('#result_installments').html(html);
    for(var i in mptools_commisions) {
        var c = mptools_commisions[i];
        calcInstallments($('#inputSixTDC').val(), c.price, '#mptools_commisions_'+i);
    }
}
</script>


