tant;}.header-main .current-dropdown .cart-icon strong,.header-main .header-button > .button:hover,.header-main .header-button > .button:hover i,.header-main .header-button > .button:hover span{color:#FFF!important;}.header-main .menu-title:hover,.header-main .social-icons a:hover,.header-main .header-button > .button.is-outline:hover,.header-main .nav > li > a:hover > i:not(.icon-angle-down){color: #111111!important;}.header-main .current-dropdown .cart-icon strong,.header-main .header-button > .button:hover{background-color: #111111!important;}.header-main .current-dropdown .cart-icon strong:after,.header-main .current-dropdown .cart-icon strong,.header-main .header-button > .button:hover{border-color: #111111!important;}.absolute-footer, html{background-color: #ffffff}/* Custom CSS */p, a, h1, h2, h3, h4, h5, h6, span, strong, label, input, .nav > li > a{font-family:"century-gothic";}#header #wide-nav .container .flex-col:first-child{width: 83%;}#header #wide-nav .container .flex-col:first-child .header-nav{justify-content: space-between;} body #header .ignore-active .nav-top-link {color: unset;}body #header .ignore-active:hover .nav-top-link {color: rgba(17,17,17,0.85);}body #header .ignore-active .nav-top-link::before {opacity: 0;width: 0%;}body #header .ignore-active:hover .nav-top-link::before {opacity: 1;width: 100%;}body .header-search-form #woocommerce-product-search-field-0 {border-radius: 10px 0 0 10px;border: 0;box-shadow: none;background-color: #F2F2F2;height: 2.6em;}body .header-search-form .submit-button {border-radius: 0 10px 10px 0;height: 2.6em;}.icons_section{box-shadow: inset 0 8px 6px -6px #969696;}/*.icons_section .home_icon .icon{position: unset;}.icons_section .home_icon{display: flex;justify-content: center;}.icons_section .home_icon .icon-box-img{margin: 0;}.icons_section .home_icon .icon-box-text{display: flex;align-items: center;max-width: max-content;margin: 0;}*/.home .img_zoom > div, .home .img_zoom a div {overflow: visible;}img.brands_slider {object-fit: contain;max-height: 174px;margin: auto 0;}.home_form_cont .bg-fill{border-radius: 25px;}.home_contact{max-width: 600px;}.home .home_contact .wpforms-field label{text-align: left;margin-left: 20px}.home .home_contact .wpforms-field input.wpforms-field-large, .home .home_contact .wpforms-field textarea.wpforms-field-medium{border-radius: 25px;border: none;/*box-shadow: 0 3px 3px 0 #ccc;*/}.home .home_contact .wpforms-submit-container .home_contact_bttn{background-color: var(--primary-color);color: #fff;border-radius: 80px;padding: 5px 50px;font-weight: 900;font-size: 1.2em;border-color: var(--primary-color);}.home .newsletter_form{margin: 0;}.home .newsletter_form form{display: flex;align-items: center;margin: 0;}.home .newsletter_form form .wpforms-field-container{width: 100%;}.home .newsletter_form form .newsletter_input{padding: 0;}.home .newsletter_form form .newsletter_input input{border: none;border-radius: 20px 0 0 20px;padding-left: 20px;}.home .newsletter_form form .wpforms-submit-container{padding: 0;}.home .newsletter_form form .wpforms-submit-container .newsletter_bttn{padding: 0 40px;height: 38px;min-height: unset;border: none;background-color: #363636;color: #fff;border-radius: 0 20px 20px 0 !important;}.home .newsletter_form form .wpforms-submit-container .newsletter_bttn:hover{border: none;}.tate_thank_you_form .hide_field{display: none;}#main .tate_thank_you_form .tate_thank_you_btn{border-radius: 99px;background-color: #fff;color: var(--primary-color);font-size: 1.15em;letter-spacing: .03em;font-weight: bolder;text-align: center;line-height: 2.4em;min-height: 2.5em;padding: 0 5px;width: 100%;}#main .tate_thank_you_form .tate_thank_you_btn:hover{background-color: #e0e0e0;}.round_icons {border-radius: 22px;}.steps_section {overflow: hidden;}.single-product .woocommerce-tabs .product-tabs li {padding: 0 4px;}.single-product .tab-panels #tab-wcpoa_product_tab .wcpoa_attachment{margin: 40px 0;}.single-product .tab-panels #tab-wcpoa_product_tab .wcpoa_attachment .wcpoa_attachment_name{display: inline-flex;align-items: center;}.single-product .tab-panels #tab-wcpoa_product_tab .wcpoa_attachment .wcpoa_attachmentbtn{color: var(--primary-color);font-weight: 600;border: 2px solid;border-radius: 90px;background-color: #ffffff00;}.product-main .quantity .minus, .cart_item .product-quantity .minus{border-radius: 90px 0 0 90px !important;}.product-main .quantity .plus, .cart_item .product-quantity .plus{border-radius: 0 90px 90px 0 !important;}.badge-container .badge .on-sale{color: var(--primary-color);border-radius: 5px;}.shop-container .products .product .col-inner{border-radius: 10px;overflow: hidden;}.shop-container .products .product .col-inner .box-image img{object-fit: contain;}.box-image .image-fade_in_back .show-on-hover{background-color: #fff;}.slider .box-image img.attachment-woocommerce_thumbnail {object-fit: contain;height: 100%;position: absolute;}.shop-page-title > .page-title-inner > .form-flat {display: none;}#menu-shop-categories{display: flex;margin-top: -10px;flex-wrap: wrap;}#menu-shop-categories .menu-item{width: calc(16.66% - 8px);box-sizing: border-box;text-align: center;font-size: .9em;border: 1px solid #e74119;border-radius: 10px;padding: 5px;margin: 0 4px;margin-bottom: 8px;display: flex;align-items: center;transition: .3s;}#menu-shop-categories .menu-item:hover{box-shadow: 0 3px 5px 0 #a7a7a7;transform: perspective(1px) translatey(-2px) scale(1.01);}#menu-shop-categories .menu-item a{color: #e74119;}.home_form_cont .section-content .home_contact .wpforms-confirmation-container-full {background: none;border: none;}.home_form_cont .section-content .home_contact .wpforms-confirmation-container-full p {color: #fff;font-weight: 900;font-size: 1.5em;}.home_file_icons .col-inner{display: flex;align-items: center;}.home_file_icons .col-inner h3{margin: 0;}#main .files_list .file_item{width: calc(50% - 1.3em);}#main .files_list .file_item.file_item_trazabilidad{width: 100%;}#main .files_list .file_item.file_item_trazabilidad .file_link{font-size: 1.6em;}#main .files_list .file_item .file_download_icon {width: 18px;margin-right: 5px;}#main .files_list .file_item.file_item_trazabilidad .file_download_icon {width: 30px;}#main .files_list .file_item.file_item_trazabilidad .weight_list_p {font-size: 1.2em;margin-bottom: 15px;}#main .files_list .file_item.file_item_trazabilidad .weight_list {list-style: none;display: flex;flex-wrap: wrap;margin: 0 0 15px 0;}#main .files_list .file_item.file_item_trazabilidad .weight_list li {margin: 0 0 .6em 0;padding: 0 8px;}#main .files_list .file_item.file_item_trazabilidad .weight_list li:not(:last-child) {border-right: 1px solid;}.form_row_cont > .col{padding-bottom: 0;}#tab_historia .banner .text-box .row .col p{font-size: 12px;margin: 0;}.rrhh > .bg{border-radius: 25px;}.product-main .all_product_icons{display: flex;align-items: center;margin-top: 35px;}.product-main .product_icon_cont{display: flex;justify-content: flex-start;align-items: center;margin-bottom: 10px;}.product-main .product_icon_cont > div{margin: 0}.installment-price{/*width: -webkit-fill-available;*/}a.button.is-outline.circle.icon.button.product-video-popup.tip-top.tooltipstered{display: none;}.badge-inner.secondary.on-sale {display: none;}.moretti_ventas{vertical-align: middle;}.back-to-top {display: none !important;}#wpforms-32435-field_5_suggestion{display: none !important;}/* Custom CSS Tablet */@media (max-width: 849px){#menu-shop-categories .menu-item{width: calc(33.33% - 8px);}}/* Custom CSS Mobile */@media (max-width: 549px){.icons_section .icon-box .icon-box-text{display: contents;padding: 0;text-align: center;font-size: .9em;}#menu-shop-categories .menu-item{width: calc(50% - 8px);}#main .files_list .file_item{width: 100%;}#tab_historia .banner .text-box .row .col p{font-size: 10px;}}.label-new.menu-item > a:after{content:"Nuevo";}.label-hot.menu-item > a:after{content:"Caliente";}.label-sale.menu-item > a:after{content:"Oferta";}.label-popular.menu-item > a:after{content:"Popular";}</style></head>

