RewriteEngine On
RewriteBase /

# Cache: index.html siempre fresco para evitar bundles viejos
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  ExpiresActive On
  ExpiresDefault "access"
</FilesMatch>

# Assets hasheados (js/css): cache larga e inmutable
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# 1. Si es la carpeta backapi, NO HACER NADA Y SALIR
RewriteRule ^backapi($|/) - [L]

# 1.b Bloquear acceso web al código fuente del frontend (React/Vite)
RewriteRule ^frontend($|/) - [F,L]

# 2. Si el archivo existe (imagenes, js, css), cargarlo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 3. Todo lo demás a React
RewriteRule . /index.html [L]
